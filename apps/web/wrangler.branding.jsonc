{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "radiant-images-branding",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "radiantimagesct.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist/branding",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
