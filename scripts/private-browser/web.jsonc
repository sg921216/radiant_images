{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Local use only. Build the web app with the documented acceptance origins first.
  "name": "radiant-images-browser-web-local",
  "main": "web.ts",
  "compatibility_date": "2026-11-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "../../.wrangler/private-browser/web-client",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "dev": { "ip": "127.0.0.1", "port": 4273, "inspector_port": 9254 },
  "observability": { "enabled": false },
  "send_metrics": false,
}
